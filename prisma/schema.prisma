generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String?
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SitemapShop {
  id                String         @id @default(cuid())
  shop              String         @unique
  configJson        String
  manifestJson      String?
  lastSyncedAt      DateTime?
  lastSyncStatus    String         @default("NEVER_SYNCED")
  lastSyncError     String?
  totalLinks        Int            @default(0)
  truncated         Boolean        @default(false)
  sitemapPageId     String?
  sitemapPageHandle String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  chunks            SitemapChunk[]
}

model SitemapChunk {
  id          String      @id @default(cuid())
  shop        String
  section     String
  chunkIndex  Int
  payloadJson String
  linkCount   Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sitemapShop SitemapShop @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@unique([shop, section, chunkIndex])
  @@index([shop, section])
}

model MarketingSubscription {
  shop           String    @id
  email          String
  status         String    @default("SUBSCRIBED")
  consentedAt    DateTime
  consentSource  String
  consentVersion String
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
